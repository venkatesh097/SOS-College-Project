<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/connection_status"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_device_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No module connected"
        android:textSize="14sp"
        android:layout_marginBottom="30dp"
        android:textColor="@color/status_disconnected"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sos"
        style="@style/Widget.Material3.Button.ElevatedButton"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:backgroundTint="@color/emergency_red"
        android:text="@string/sos_button"
        android:textColor="@color/white"
        android:textSize="32sp"
        android:textStyle="bold"
        app:cornerRadius="100dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="Press for 2 seconds to trigger SOS"
        android:textAlignment="center"
        android:textColor="@color/emergency_red" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_connect_bt"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:text="Manage Connection" />

</LinearLayout>
